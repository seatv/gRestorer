{
	"process": "mosaic",
	"debug_enabled": false,
	"roi_dilate": 4,
	"use_seg_masks": true,
	"batch_size": 8,
	"debug": {
		"save_detection_frames": false,
		"save_detection_json": false,
		"output_dir": "debug_output",
		"face_swap": {
			"trace": false,
			"trace_dir": "D:\\Temp\\fs_trace",
			"debug_images": false,
			"debug_dir": "D:\\Temp\\fs_debug",
			"material_mad": 1.0
		}
	},
	"runtime": {
		"gpu_id": 0,
		"batch_size": 8,
		"store_max_frames": 0
	},
	"synth_mosaic": {
		"block_size": 40,
		"rois": [
			[ 240, 260, 820, 980 ],
			[ 920, 1520, 1500, 2240 ],
			[ 1460, 2480, 2060, 3340 ]
		]
	},
	"decoder": {
	"output_format": "RGB",
		"gpu_id": 0
	},
	"encoder": {
		"codec": "hevc",
		"preset": "P7",
		"profile": "main",
		"qp": 20,
		"format": "ARGB",
		"gpu_id": 0,
		"sync_before_encode": true
	},
	"mosaic_detection": {
		"det_type": "yolo",
		"model_path": "D:\\Models\\lada\\lada_mosaic_detection_model_v3.1_accurate.pt",
		"batch_size": 8,
		"conf_threshold": 0.5,
		"iou_threshold": 0.45,
		"imgsz": 960,
		"fp16": true
	},
	"mosaic_restoration": {
		"rest_model_path": "D:\\Models\\lada\\lada_mosaic_restoration_model_generic_v1.2.pth",
		"fp16": true,
		"max_clip_length": 60,
		"clip_size": 256,
		"border_ratio": 0.06,
		"pad_mode": "reflect",
		"feather_radius": 0,
		"blendmask": "none"
	},
	"face_detection": {
		"det_type": "face",
		"model_path": "D:\\Models\\face\\retinaface_10g.onnx",
		"batch_size": 8,
		"conf_threshold": 0.5,
		"iou_threshold": 0.45,
		"imgsz": 960,
		"fp16": true,
		"suppress_onnx_warnings": true
	},
	"face_restoration": {
		"source_face_path": "D:\\FaceFusion\\source-image.jpg",
		"swap_model_path": "D:\\Models\\face\\inswapper_128.onnx",
		"swap_input_size": 128,
		"swap_provider": "cuda",
		"max_clip_length": 60,
		"clip_size": 256,
		"border_ratio": 0.06,
		"pad_mode": "reflect",
		"landmark_refiner_enabled": true,
		"landmark_model": "2dfan4",
		"landmark_model_path": "D:\\Models\\face\\2dfan4.onnx",
		"landmark_provider": "cuda",
		"landmark_refiner_score": 0.5
	},
	"enhancement": {
		"enabled": true,
		"model_path": "D:\\Models\\face\\gfpgan_1.4.onnx",
		"provider": "cuda",
		"blend": 80
	},
	"occlusion": {
		"enabled": true,
		"model_path": "D:\\Models\\face\\xseg_2.onnx",
		"threshold": 0.5,
		"blur": 5,
		"blend": 100,
		"invert": true
	},
	"scene_tracking": {
		"min_iou": 0.3,
		"max_clip_frames": 120,
		"min_clip_frames": 5
	},
	"visualization": {
		"box_color": [ 0, 255, 0 ],
		"box_thickness": 5,
		"show_confidence": true,
		"show_class": true,
		"fill_color": [ 128, 128, 128 ],
		"fill_opacity": 0.5
	},
	"batch_processing": {
			"video_extensions": [ ".mp4", ".mkv", ".avi", ".mov" ],
		"skip_existing": false
	}
}